# Local development. Fill in your own server-side key; never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Replace with a model supported by your provider/account.
CHAT_MODEL=deepseek-flash
APP_BASE_PATH=/
SECURE_COOKIE=false
DATABASE_PATH=data/self-agent.sqlite3
# Leave blank to use Jev's default local configuration.
JEV_ENV_FILE=
# Legacy compatibility only; current version does not enforce login.
SESSION_SECRET=
LOGIN_PASSWORD_HASH=
